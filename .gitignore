# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environments
venv/
env/

# Ignore Jupyter Notebook checkpoints (if used)
.ipynb_checkpoints/

# Ignore log and debug files
*.log
*.out
*.err

# Ignore environment files (security risk)
.env
*.env

# Ignore large data files (optional, if not needed in repo)
*.csv
*.xlsx

# Ignore VS Code and PyCharm project settings (optional)
.vscode/
.idea/

# Ignore deployment and build files (if hosted)
*.zip
*.tar.gz
.DS_Store
